{
  "name": "mutant-farm-roguelike",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/link-public.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "server": "tsx --tsconfig server/tsconfig.json server/index.ts",
    "server:typecheck": "tsc --noEmit -p server/tsconfig.json",
    "assets:audit": "node scripts/audit-assets.mjs",
    "audio:audit": "node scripts/audit-audio-candidates.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "9.25.0",
    "@babylonjs/havok": "^1.3.14",
    "@babylonjs/loaders": "9.25.0",
    "@colyseus/schema": "^5.0.27",
    "@colyseus/sdk": "^0.18.2",
    "@colyseus/ws-transport": "^0.18.2",
    "@recast-navigation/core": "^0.43.1",
    "@recast-navigation/generators": "^0.43.1",
    "colyseus": "^0.18.5"
  },
  "devDependencies": {
    "@colyseus/loadtest": "^0.18.2",
    "@colyseus/testing": "^0.18.5",
    "@types/node": "22.18.0",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
